# SEEK uses direct collection; other boards use JobSpy. No Apify key is required.
JOB_SEARCH_PROVIDER=jobspy
JOB_SEARCH_MAX_WORKERS=4
# Reuse complete identical searches for 15 minutes; 0 disables collection caching.
JOB_COLLECTION_CACHE_TTL_SECONDS=900
JOB_COLLECTION_CACHE_MAX_ENTRIES=256
# Candidate cards per retained JobSpy posting (1–5); optional details load after screening.
# If unset, LinkedIn also honors LINKEDIN_SCREEN_POOL_FACTOR.
JOBSPY_SCREEN_POOL_FACTOR=3
# Public Indeed descriptions; LinkedIn keeps its existing cache settings.
JOBSPY_DESCRIPTION_CACHE_TTL_SECONDS=604800

# Model IDs are backend configuration. Profile extraction uses OpenAI only.
# One candidate-independent requirement extraction per uncached posting.
REQUIREMENT_EXTRACTION_MODEL=gpt-4o-mini
EVALUATION_PROVIDER=claude
# Before each search, one tiny request checks each evaluation model. A model out
# of quota or spend cap, or with rejected credentials, is skipped and reported.
# CAREER_EVALUATION_PREFLIGHT=false
CLAUDE_EVALUATION_MODEL=claude-sonnet-5-5
GPT_EVALUATION_MODEL=gpt-6.1-sol
# Per SDK request timeout; bounded to 30–600 seconds.
GPT_EVALUATION_TIMEOUT_SECONDS=180
GEMINI_EVALUATION_MODEL=gemini-4-argon
# 0 disables proactive RPM pacing; rate-limit backoff still applies.
GEMINI_EVALUATION_RPM=0
# Reads the resume once per upload. Reasoning models run at low reasoning effort;
# gpt-3/gpt-4 family models keep temperature 0.
OPENAI_PROFILE_MODEL=gpt-6.1-sol
# Optional upload override; otherwise OPENAI_PROFILE_MODEL is used.
# OPENAI_UPLOAD_MODEL=gpt-6.1-sol
# Standalone compatibility validator only (not the normal upload flow).
OPENAI_RESUME_CHECK_MODEL=gpt-4o-mini
# Install the corresponding Tesseract language packs for non-English OCR.
OCR_LANGUAGES=eng

# Combined adaptive web-search limits across boards/roles (not per board).
JOB_COLLECTION_MAX_BATCHES=12
JOB_COLLECTION_MAX_DETAILS=60
JOB_COLLECTION_MAX_CANDIDATES=150
# The detail and time limits end the search rounds only; afterwards every collected
# card's description is still read (only cancellation or the candidate limit stops it).
# Soft deadline: an in-flight provider call can finish after this limit.
JOB_COLLECTION_MAX_SECONDS=240
# Retrieval queries: 'hyde' (default: evidence, with model-written job ads in place of role
# titles; uses OPENAI_PROFILE_MODEL), 'evidence' (weighted by resume evidence), 'skills'
# (skill queries only, weighted by experience; entry text is not searched) or 'legacy'.
# QUERY_BUILDER=hyde
# Override any retrieval weight default (see DEFAULT_RETRIEVAL_WEIGHTS in backend/search/ranking.py).
# RETRIEVAL_WEIGHTS={"votes": {"soft_skills": 0.5}, "experience_queries": 8}
# Google Jobs board (optional, paid): each results page of up to 10 jobs is one SerpApi search.
# SERPAPI_API_KEY=
# Adzuna board (optional, free tier with registration at developer.adzuna.com).
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# Adzuna requests per search (each returns up to 50 jobs); keep low on the free tier.
# ADZUNA_MAX_REQUESTS=2

# Optional payload-free stage tracing (off by default).
CAREER_LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=career-tracker
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Do not enable automatic prompt tracing; application stages use explicit safe spans.
LANGSMITH_TRACING=false
